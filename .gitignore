.env
.playwright-mcp/
.claude

# Python bytecode caches, in any folder at any depth
__pycache__/
*.pyc

# spotify cached user token (contains a refresh token)
.spotify_token.json

# Symlinked skills that live in other repos (machine-specific targets)
events-add
events-coda
events-crawl

# social-calendar local state (added / declined / banned series; personal, never published)
social-calendar/state.json
# kokandus.py's snapshot of the cooking courses (crawl state, rewritten on every run)
social-calendar/kokandus.json

# Claude Code's auto-sync of claude.ai account skills, and its discard pile (machine-managed)
synced/
.trash/